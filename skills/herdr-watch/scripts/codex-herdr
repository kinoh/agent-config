#!/usr/bin/env python3
"""Launch Codex with this Herdr pane's explicit subprocess environment."""
from __future__ import annotations

import json
import os
import shutil
import sys


def launch_args(args: list[str], environ: dict[str, str]) -> list[str]:
    if environ.get("HERDR_ENV") != "1":
        return args
    required = ("HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID", "HERDR_SOCKET_PATH")
    missing = [key for key in required if not environ.get(key)]
    if missing:
        raise ValueError("missing Herdr launch environment: " + ", ".join(missing))
    overrides = []
    for key, value in sorted(environ.items()):
        if key.startswith("HERDR_") and key.isidentifier():
            overrides.extend(["-c", f"shell_environment_policy.set.{key}={json.dumps(value, ensure_ascii=False)}"])
    return ["--no-daemon"] + overrides + args


def main() -> int:
    try:
        args = launch_args(sys.argv[1:], dict(os.environ))
        binary = shutil.which("codex")
        if binary is None:
            raise OSError("codex not found on PATH")
        print(f"codex-herdr: launching {binary}", file=sys.stderr)
        if os.environ.get("HERDR_ENV") == "1":
            print("codex-herdr: using this pane's Herdr environment", file=sys.stderr)
        os.execv(binary, [binary, *args])
    except (ValueError, OSError) as exc:
        print(f"codex-herdr: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
